        {"name": "tanh he",         "activation": "tanh",    "weight_init": "he"},
        {"name": "sigmoid xavier",  "activation": "sigmoid", "weight_init": "xavier"},
        {"name": "sigmoid he",      "activation": "sigmoid", "weight_init": "he"},
        {"name": "relu xavier",     "activation": "relu",    "weight_init": "xavier"},
        {"name": "relu he",         "activation": "relu",    "weight_init": "he"}
